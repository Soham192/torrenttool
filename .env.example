# For Docker: use QBIT_HOST=qbittorrent (the container name)
# For local dev: use QBIT_HOST=localhost
QBIT_HOST=qbittorrent
QBIT_PORT=8080
QBIT_USERNAME=admin
QBIT_PASSWORD=changeme
DEFAULT_SAVE_PATH=/downloads

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Discord bot (optional)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
DISCORD_CHANNEL_ID=
